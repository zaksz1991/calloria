# Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Prefer the new publishable key. The legacy anon key is also accepted.
# Never place a service_role JWT or Supabase secret key in a VITE_ variable.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# VITE_SUPABASE_ANON_KEY=eyJ_REPLACE_ME
