{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "supabase/functions/calloria-agent-desk/**/*.ts",
    "supabase/functions/calloria-agent-desk/**/*.d.ts",
    "supabase/functions/calloria-workforce/**/*.ts",
    "supabase/functions/calloria-workforce/**/*.d.ts",
    "supabase/functions/calloria-performance/**/*.ts",
    "supabase/functions/calloria-performance/**/*.d.ts",
    "supabase/functions/calloria-sales-desk/**/*.ts",
    "supabase/functions/calloria-sales-desk/**/*.d.ts",
    "supabase/functions/calloria-contact-routing/**/*.ts",
    "supabase/functions/calloria-contact-routing/**/*.d.ts",
    "supabase/functions/calloria-whatsapp/**/*.ts",
    "supabase/functions/calloria-whatsapp/**/*.d.ts",
    "supabase/functions/calloria-email/**/*.ts",
    "supabase/functions/calloria-email/**/*.d.ts",
    "supabase/functions/calloria-web-chat/**/*.ts",
    "supabase/functions/calloria-web-chat/**/*.d.ts",
    "supabase/functions/calloria-social-inbox/**/*.ts",
    "supabase/functions/calloria-social-inbox/**/*.d.ts",
    "supabase/functions/calloria-voice-telephony/**/*.ts",
    "supabase/functions/calloria-voice-telephony/**/*.d.ts"
  ]
