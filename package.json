{
  "name": "calloria-contact-centre-simulator",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "CALLORIA — multi-industry contact-centre career and operations simulator.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "preinstall": "node tools/calloria-build-preflight.mjs --install",
    "prebuild": "node tools/calloria-build-preflight.mjs --build",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "verify:build-manifest": "node tools/calloria-build-preflight.mjs --manifest",
    "check": "node tools/calloria-build-preflight.mjs --manifest",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "vite": "6.4.5"
  }
}
